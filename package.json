{
  "name": "@davidabou/icons",
  "version": "0.2.1",
  "author": "davidabou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidabou/icons.git"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Rounded outline SVG icons, 24×24 with a 2px stroke. Extended fork of CodeX Icons.",
  "files": [
    "dist/index.mjs",
    "dist/index.d.ts"
  ],
  "homepage": "https://icons.abou.dev",
  "keywords": ["icons", "svg", "svg-icons", "icon-set", "outline-icons", "rounded-icons", "vue", "react", "nuxt", "codex"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run generate && vite build",
    "generate": "bun bin/generate.ts",
    "playground:dev": "bun run --cwd packages/nuxt dev",
    "site:dev": "bun run --cwd packages/site dev",
    "site:generate": "bun run --cwd packages/site generate",
    "react:test": "bun run --cwd packages/react test",
    "set-version": "bun bin/set-version.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "vue:test": "bun run --cwd packages/vue test"
  },
  "types": "./dist/index.d.ts",
  "workspaces": [
    "packages/vue",
    "packages/react",
    "packages/nuxt"
  ]
}
